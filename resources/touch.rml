<rml><head><title>Touch</title><style>
body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; z-index: 50; font-family: "Liberation Sans"; }
.b { position: absolute; border-width: 2dp; border-color: #ffffffaa; background-color: #10182a66; color: #ffffffdd; text-align: center; font-weight: bold; }
.b.down { background-color: #ffffff88; color: #10182a; }
#A { background-color: #1fa36b77; } #B { background-color: #d2353577; } #START { font-size: 10dp; }
.stick { position: absolute; border-width: 2dp; border-color: #ffffff77; background-color: #10182a44; }
.knob { position: absolute; border-width: 2dp; border-color: #ffffffcc; background-color: #ffffff55; }
</style></head><body id="touch-body"><div class="stick" id="stick"/><div class="knob" id="knob"/></body></rml>
